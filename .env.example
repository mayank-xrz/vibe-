# Appwrite
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT=your_project_id
APPWRITE_DATABASE_ID=your_database_id
APPWRITE_USER_COLLECTION_ID=your_user_collection_id
APPWRITE_BANK_COLLECTION_ID=your_bank_collection_id
APPWRITE_TRANSACTION_COLLECTION_ID=your_transaction_collection_id
NEXT_APPWRITE_KEY=your_appwrite_api_key

# Plaid
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_sandbox_secret
PLAID_ENV=sandbox
PLAID_PRODUCTS=auth,transactions,identity
PLAID_COUNTRY_CODES=US,CA

# Dwolla
DWOLLA_KEY=your_dwolla_sandbox_key
DWOLLA_SECRET=your_dwolla_sandbox_secret
DWOLLA_BASE_URL=https://api-sandbox.dwolla.com
DWOLLA_ENV=sandbox

# Sentry
SENTRY_DSN=your_sentry_dsn

# App
# Local dev: http://localhost:3000
# Netlify production: https://singular-cannoli-323f40.netlify.app
NEXT_PUBLIC_SITE_URL=https://singular-cannoli-323f40.netlify.app

# Seed test account (used by `npm run seed` only — never a master/admin login).
# Creates one ordinary user through the normal signup flow so you can log in
# repeatedly for testing. Choose your own values; do not commit real ones.
SEED_USER_EMAIL=testuser@example.com
SEED_USER_PASSWORD=Test1234!

# Demo / competition account (used by `npm run seed:demo` only).
# Creates one real account with a linked Plaid sandbox bank and sample
# transactions so judges can log in and see a populated dashboard.
# Choose your own values; do not commit real credentials.
DEMO_EMAIL=demo@horizon-banking.com
DEMO_PASSWORD=Demo1234!
